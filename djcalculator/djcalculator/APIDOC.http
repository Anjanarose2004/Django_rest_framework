#Api call for adding two numbers
###
POST http://127.0.0.1:8000/addition/
Content-Type: application/json

{
    "num1": 10,
    "num2": 20
}

#API for subtraction of two numbers
###
POST http://127.0.0.1:8000/subtraction/
Content-Type:application/json

{
    "num1": 30,
    "num2":10
}

